# Copy to .env and fill in, OR run: ./setup.sh (recommended).
# .env contains secrets and is gitignored. Never commit it.

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_NAME=example.com
# Public IPv4 address used for coturn's external-ip.
SERVER_IP=203.0.113.10
ADMIN_EMAIL=admin@example.com
# 1 = token-only registration, 2 = open registration.
REG_MODE=1

# Optional custom hostnames. setup.sh writes the resolved values; when they
# are absent the defaults are element.<SERVER_NAME>, call.<SERVER_NAME>, etc.
# ELEMENT_HOST=element.example.com
# CALL_HOST=call.example.com
# SFU_HOST=sfu.example.com
# TURN_HOST=turn.example.com
# NTFY_HOST=ntfy.example.com
# STATUS_HOST=status.example.com
# BRIDGE_HOST=bridge.example.com

# Reverse proxy: auto (detect), bundled (own Caddy on 80/443) or external
# (existing proxy). In external mode setup.sh also writes COMPOSE_FILE and
# docker-compose.external.yml, and keeps Caddy on an internal port. The
# resolved mode is stored here; external mode persists across re-runs.
# PROXY_MODE=auto
# EXTERNAL_PROXY=nginx   # optional hint when the proxy is not on this host
# CADDY_INTERNAL_BIND=127.0.0.1
# CADDY_INTERNAL_PORT=8080

# Host user that owns data/ and runs the homeserver container.
PUID=1000
PGID=1000

# ── Secrets ───────────────────────────────────────────────────────────────────
# setup.sh reuses these values on re-runs; use --rotate-secrets to replace them.
REGISTRATION_TOKEN=change-me
TURN_SHARED_SECRET=change-me
LIVEKIT_API_KEY=lk_change_me
LIVEKIT_API_SECRET=change-me

# ── Optional features ─────────────────────────────────────────────────────────
# Comma-separated bridge profiles: telegram,discord,whatsapp,signal
# Leave empty to run the core stack only. The proxy mode does not use profiles.
COMPOSE_PROFILES=
BRIDGES=

# Telegram bridge only (https://my.telegram.org/apps):
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Monitoring / backups ──────────────────────────────────────────────────────
NTFY_ALERT_TOPIC=alerts
BACKUP_RETENTION_DAYS=14

# Optional off-site backup via restic (leave empty to back up locally only).
# RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/matrix
# RESTIC_PASSWORD=change-me
