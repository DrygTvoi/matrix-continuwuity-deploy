# Secrets — never commit these
.env

# Generated config files (contain domain-specific values and secrets)
docker-compose.external.yml
config/proxy/
config/Caddyfile
config/continuwuity.toml
config/livekit.yaml
config/turnserver.conf
config/element-web.json
config/element-call.json
config/ntfy.yml

# Bridge configs, registrations and databases (generated by setup.sh)
bridges/*/config.yaml
bridges/*/registration.yaml
bridges/*/*.db
bridges/*/*.db-shm
bridges/*/*.db-wal
bridges/*/*.log

# Runtime data
data/
backups/

# Archives
*.tar
*.tar.gz
*.tgz

# Python cache
__pycache__/
*.pyc
